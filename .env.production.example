# Stack de produção local (compose.prod.yaml). Copie para `.env.production`
# (ignorado pelo git), troque os segredos e suba com:
#
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build
#
# Os valores abaixo são exemplos; nenhum deles é um segredo real.

# Portas publicadas no host. Os defaults não colidem com os compose de dev.
APP_PORT=8088
STORAGE_PORT=9200
MAILPIT_PORT=8125

# Postgres
DB_USERNAME=streamtube
DB_PASSWORD=troque-esta-senha
DB_NAME=streamtube

# JWT da API
JWT_SECRET=troque-este-segredo-de-acesso
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh

# Segredo compartilhado entre API e BFF (X-Internal-Token). Um único valor.
INTERNAL_API_SECRET=troque-este-segredo-interno

# Sessão do BFF (iron-session): no mínimo 32 caracteres.
SESSION_PASSWORD=troque-esta-senha-de-sessao-com-32-caracteres

# MinIO (credenciais root do storage e da API). A senha precisa de 8+ caracteres.
MINIO_ACCESS_KEY=streamtube
MINIO_SECRET_KEY=troque-esta-chave-do-minio
