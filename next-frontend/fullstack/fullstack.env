# Env da suíte full-stack (testes-producao/TD-01, TD-02). Valores SÓ de teste —
# nenhum é segredo real. A suíte sobe o compose.prod.yaml da raiz com outro nome
# de projeto (`-p streamtube-fullstack`) e estas portas, então roda ao lado da
# stack de produção local e dos compose de dev sem tocar nos dados deles.
#
# O nome não começa com ".env" porque o .gitignore do next-frontend ignora
# `.env*` e este arquivo precisa ser versionado.

APP_PORT=8180
STORAGE_PORT=9280
MAILPIT_PORT=8181

DB_USERNAME=streamtube
DB_PASSWORD=fullstack-db-password
DB_NAME=streamtube

JWT_SECRET=fullstack-jwt-secret
JWT_REFRESH_SECRET=fullstack-jwt-refresh-secret

INTERNAL_API_SECRET=fullstack-internal-api-secret

SESSION_PASSWORD=fullstack-session-password-with-32-chars

MINIO_ACCESS_KEY=streamtube
MINIO_SECRET_KEY=fullstack-minio-secret
